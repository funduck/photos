# Docker compose environment

# Immich & general
DB_PASSWORD=qwerty
IMMICH_DIR=/Users/you/Immich
STORAGE_DIR=/Volumes/EXTDATA/Photos

# Caddy reverse proxy - domain must resolve to this host and have ports 80/443 reachable
# for Caddy to obtain a Let's Encrypt certificate automatically.
IMMICH_DOMAIN=immich.example.com
IMMICH_EMAIL=your@email.com

# rclone s3 sync
AWS_BUCKET=you-photo-archive
AWS_REGION=eu-central-1

# first perform aws setup, then paste secrets here
RCLONE_REMOTE=s3
RCLONE_ACCESS_KEY=ABC
RCLONE_SECRET_ACCESS_KEY=Abc

# Options for periodic sync
RCLONE_SYNC_NAME=Photos # names the state file only; $STORAGE_DIR is copied to the bucket root
RCLONE_SYNC_INTERVAL=24h # 15m, 12h, 2d
RCLONE_SYNC_DRY_RUN=true

# album-exporter: copies Immich albums into folders, each photo once.
# The API key needs album.read, asset.read, asset.download. Jobs' dest paths in
# services/album-exporter/config.yaml are under /export, which is this directory.
# Optional, behind a compose profile: uncomment to have `docker compose up -d` start it.
# COMPOSE_PROFILES=album-exporter
ALBUM_EXPORT_API_KEY=abc
ALBUM_EXPORT_DIR=/Users/you/AlbumExports # outside the ingest source: the exporter refuses a dest inside one

# person-album: adds the photos of chosen people to Immich albums, each photo once.
# Jobs run per Immich account, since people and albums are per user: one API key per
# account, each with person.read, asset.read, album.read, albumAsset.create. Each job
# in services/person-album/config.yaml picks its key. Leave unused accounts empty.
# Optional, behind a compose profile; profiles are comma-separated:
# COMPOSE_PROFILES=album-exporter,person-album
PERSON_ALBUM_API_KEY_OLEG=abc
PERSON_ALBUM_API_KEY_KATE=
