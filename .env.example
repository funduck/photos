# Docker compose environment

# Immich & general
DB_PASSWORD=qwerty
IMMICH_DIR=/Users/you/Immich
STORAGE_DIR=/Volumes/EXTDATA/you

# rclone s3 sync
AWS_BUCKET=you-photo-archive
AWS_REGION=eu-central-1

# first perform aws setup, then paste secrets here
RCLONE_REMOTE=s3
RCLONE_ACCESS_KEY=ABC
RCLONE_SECRET_ACCESS_KEY=Abc

# Options for periodic sync
RCLONE_SYNC_SUBDIR=Photos
RCLONE_SYNC_INTERVAL=24h # 15m, 12h, 2d
RCLONE_SYNC_DRY_RUN=true
